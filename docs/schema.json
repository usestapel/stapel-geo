    "/geo/api/v1/geocoding/search": {
      "get": {
        "operationId": "geo_api_v1_geocoding_search_retrieve",
        "description": "Forward geocoding — search places by free-text query.",
        "summary": "Search places by text",
        "parameters": [
          {
            "in": "query",
            "name": "bbox",
            "schema": {
              "type": "string"
            },
            "description": "Hard restriction 'min_lon,min_lat,max_lon,max_lat'; defaults to STAPEL_GEO['MAP_BBOX']."
          },
          {
            "in": "query",
            "name": "bias_lat",
            "schema": {
              "type": "number",
              "format": "float"
            },
            "description": "Soft bias latitude (the map's centre)."
          },
          {
            "in": "query",
            "name": "bias_lon",
            "schema": {
              "type": "number",
              "format": "float"
            },
            "description": "Soft bias longitude (the map's centre)."
          },
          {
            "in": "query",
            "name": "bias_scale",
            "schema": {
              "type": "number",
              "format": "float"
            },
            "description": "Bias strength, 0.0-1.0."
          },
          {
            "in": "query",
            "name": "lang",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Search query",
            "required": true
          },
          {
            "in": "query",
            "name": "zoom",
            "schema": {
              "type": "integer"
            },
            "description": "Map zoom the bias is scaled against."
          }
        ],
        "tags": [
          "Geocoding"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResponse"
                },
                "examples": {
                  "GeocodeResponse": {
                    "value": {
                      "type": "FeatureCollection",
                      "lang": "default"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
