{
  "openapi": "3.0.3",
  "info": {
    "title": "",
    "version": "0.0.0"
  },
  "paths": {
    "/geo/api/v1/geocoding/resolve": {
      "get": {
        "operationId": "geo_api_v1_geocoding_resolve_retrieve",
        "description": "One coordinate pair in, one confirmable place out.\n\nThe endpoint the browser's ``navigator.geolocation`` result goes\nstraight to, and the one a dragged map pin goes to on drop. It answers\nwith the display line, the address components, the geohash to store\nand the runner-up candidates — everything a \"is this your address?\"\nconfirmation step renders, in one round trip.",
        "summary": "Resolve a coordinate pair to a confirmable place",
        "parameters": [
          {
            "in": "query",
            "name": "lang",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lat",
            "schema": {
              "type": "number",
              "format": "float"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "description": "Candidates to consider (1 pick + alternatives)."
          },
          {
            "in": "query",
            "name": "lon",
            "schema": {
              "type": "number",
              "format": "float"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "nearest",
            "schema": {
              "type": "integer"
            },
            "description": "Also return N nearest known Location rows (0 = none)."
          },
          {
            "in": "query",
            "name": "radius_km",
            "schema": {
              "type": "number",
              "format": "float"
            }
          }
        ],
        "tags": [
          "Geocoding"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResolution"
                },
                "examples": {
                  "PlaceResolution": {
                    "value": {
                      "lat": 52.51667,
                      "lon": 13.38333,
                      "geohash": "u33dc0cp",
                      "lang": "default",
                      "formatted": "Unter den Linden, 1, Berlin, Germany"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
